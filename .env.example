# ============================================================
#  FamilyHub: the only thing you MUST set here is the database password.
#  Everything else (app URL, time zone, Authentik, Google Calendar) is
#  configured in the app: Settings -> App settings (admins only).
# ============================================================

# Database password (used by both containers). Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# Host port to expose
KINBOARD_PORT=3000

# ------------------------------------------------------------
# Optional overrides. Anything set below takes priority over the in-app
# setting and shows as "locked" in Settings. Leave them commented out to
# manage everything from the app.
# ------------------------------------------------------------
# APP_URL=https://family.example.com
# APP_NAME=FamilyHub
# TZ=America/Denver
# LOCAL_LOGIN_ENABLED=true          # set true here to recover if you ever lock yourself out
# OIDC_ISSUER=https://auth.example.com/application/o/familyhub/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_BUTTON_LABEL=Sign in with Authentik
# OIDC_ADMIN_GROUP=
# OIDC_AUTO_CREATE_USERS=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_SYNC_INTERVAL_MINUTES=5
# SESSION_SECRET=                   # normally auto-generated into the data volume
# ENCRYPTION_KEY=                   # normally auto-generated into the data volume

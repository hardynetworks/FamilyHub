# FamilyHub OS kiosk settings. Change them on the screen (kiosk menu -> Screen settings),
# or from the admin console with: sudo familyhub-setup
# Your FamilyHub address, e.g. https://family.example.com
FAMILYHUB_URL=""
# Screen rotation: normal, 90, 180 or 270
ROTATE="normal"
# Touch rotation: auto (follows ROTATE), or normal / 90 / 180 / 270 if taps land in the wrong place
TOUCH_ROTATE="auto"
# Wi-Fi country code
WIFI_COUNTRY="US"

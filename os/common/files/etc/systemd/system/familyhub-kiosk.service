[Unit]
Description=FamilyHub kiosk screen
After=systemd-user-sessions.service plymouth-quit-wait.service familyhub-boot.service familyhub-firstboot.service NetworkManager.service
Wants=NetworkManager.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# -d: no window decorations, -s: allow Ctrl+Alt+F2 to reach the admin console
ExecStart=/usr/bin/cage -d -s -- /usr/local/bin/familyhub-browser
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
